manifest {
    contributors = [
        [
            name: "Alistair Dunham",
            affiliation: "Wellcome Sanger Institute",
            email: "ad44@sanger.ac.uk",
            github: "https://github.com/allydunham/",
            contribution: "author",
            orcid: "https://orcid.org/0000-0001-9076-3025"
        ]
    ]
    defaultBranch = "master"
    description = "Versatile pipeline from initial sequence read processing into count tables"
    docsUrl = "https://github.com/allydunham/dnacomb_pipeline"
    doi = ""
    homePage = "https://github.com/allydunham/dnacomb_pipeline"
    license = "MIT"
    mainScript = "main.nf"
    name = "DNAComb Pipeline"
    nextflowVersion = "25.04+"
    version = "0.1.0"
}

report {
    enabled = true
}

trace {
    enabled = true
}

timeline {
    enabled = true
}

dag {
    enabled = true
}

params {
    samples = ""

    downsample {
        enabled = false
        sample_size = 10000
        seed = 42
    }

    merge {
        enabled = false
        pear_args = ""
    }

    trim {
        enabled = false
        cutadapt_args = ""
    }

    quantify {
        enabled = false
        libspec = ""
        dnacomb_args = ""
    }
}