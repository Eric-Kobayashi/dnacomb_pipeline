manifest {
    contributors = [
        [
            name: 'Alistair Dunham',
            affiliation: 'Wellcome Sanger Institute',
            email: 'ad44@sanger.ac.uk',
            github: 'https://github.com/allydunham/',
            contribution: ['author'],
            orcid: 'https://orcid.org/0000-0001-9076-3025'
        ]
    ]
    defaultBranch = "release"
    description = "Versatile pipeline from initial sequence read processing into count tables"
    docsUrl = "https://github.com/allydunham/dnacomb_pipeline"
    doi = ""
    homePage = "https://github.com/allydunham/dnacomb_pipeline"
    license = "MIT"
    mainScript = "main.nf"
    name = "DNAComb Pipeline"
    nextflowVersion = ">=25.10"
    version = "1.0.0"
}

report {
    enabled = true
}

trace {
    enabled = true
}

timeline {
    enabled = true
}

dag {
    enabled = true
}

params {
    samples = ""
    dnacomb_version = System.getenv('DNACOMB_VERSION') ?: "1.0.0"
    image_repo = System.getenv('DNACOMB_IMAGE_REPO') ?: (System.getenv('DOCKERHUB_USER') ? "${System.getenv('DOCKERHUB_USER')}/dnacomb" : "mercury/dnacomb")
    container_image = System.getenv('DNACOMB_IMAGE') ?: "${System.getenv('DNACOMB_IMAGE_REPO') ?: (System.getenv('DOCKERHUB_USER') ? "${System.getenv('DOCKERHUB_USER')}/dnacomb" : "mercury/dnacomb")}:${System.getenv('DNACOMB_VERSION') ?: "1.0.0"}"

    downsample {
        enabled = false
        sample_size = 10000
        seed = 42
    }

    merge {
        enabled = false
        pear_args = ""
    }

    trim {
        enabled = false
        cutadapt_args = ""
    }

    quantify {
        enabled = false
        libspec = ""
        library = []
        dnacomb_args = ""
    }

    qc {
        seqkit = false
    }
}

process {
    container = {
        def version = params.containsKey("dnacomb_version") ? params.dnacomb_version : (System.getenv('DNACOMB_VERSION') ?: "1.0.0")
        def repo = params.containsKey("image_repo") ? params.image_repo : (System.getenv('DNACOMB_IMAGE_REPO') ?: (System.getenv('DOCKERHUB_USER') ? "${System.getenv('DOCKERHUB_USER')}/dnacomb" : "mercury/dnacomb"))
        def image = params.containsKey("container_image") ? params.container_image : (System.getenv('DNACOMB_IMAGE') ?: "${repo}:${version}")
        workflow.containerEngine == "singularity" && !image.contains("://")
            ? "docker://${image}"
            : image
    }
    containerOptions = {
        workflow.containerEngine == "docker"
            ? "-e PATH=/opt/view/bin:/opt/spack/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin -e R_LIBS=/opt/view/rlib/R/library -e R_HOME=/opt/view/rlib/R -e LD_LIBRARY_PATH=/opt/view/rlib/R/lib -e PYTHONPATH=/opt/view/lib/python3.10/site-packages"
            : workflow.containerEngine == "singularity"
                ? "--env PATH=/opt/view/bin:/opt/spack/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin --env R_LIBS=/opt/view/rlib/R/library --env R_HOME=/opt/view/rlib/R --env LD_LIBRARY_PATH=/opt/view/rlib/R/lib --env PYTHONPATH=/opt/view/lib/python3.10/site-packages"
                : ""
    }

    withName: fastqc {
        cpus   = { 1 * task.attempt }
        memory = { 4.GB * task.attempt }
    }

    withName: multiqc {
        cpus   = 1
        memory = { 4.GB * task.attempt }
    }

    withName: seqkit_stats {
        cpus   = 1
        memory = { 1.GB * task.attempt }
    }

    withName: seqtk {
        cpus   = { 1 * task.attempt }
        memory = { 4.GB * task.attempt }
    }

    withName: pear {
        cpus   = { 1 * task.attempt }
        memory = { 4.GB * task.attempt }
    }

    withName: cutadapt {
        cpus   = { 1 * task.attempt }
        memory = { 4.GB * task.attempt }
    }

    withName: dnacomb {
        cpus   = { 1 * task.attempt }
        memory = { 4.GB * task.attempt }
    }

    withName: qc_counts {
        cpus   = 1
        memory = { 8.GB * task.attempt }
    }

    withName: count_records {
        executor = "local"
    }

    withName: combine_record_counts {
        executor = "local"
    }
}

docker {
    runOptions = "--entrypoint="
}

singularity {
    autoMounts = true
}
